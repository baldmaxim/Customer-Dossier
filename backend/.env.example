# Копировать в backend/.env и заполнить вручную. Файл .env в git не попадает.

DATABASE_URL=postgresql://user:password@localhost:5432/tg_info
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_PATH=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# API слушает только loopback: 127.0.0.1, ::1 или localhost. Иное — ошибка запуска.
HOST=127.0.0.1
PORT=4100
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Вход оператора. Пусто — при первом запуске создаётся backend/.local/operator-token
# (в git не попадает). Если задаёте сами — не короче 32 символов.
OPERATOR_TOKEN=
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Фоновые задания. Только true/false/1/0; по умолчанию всё выключено.
# Открыть портал не значит начать сбор или разбор.
INGEST_ENABLED=false
# Разбор моделью с записью в канон заблокирован в коде до этапа 03B:
# при true воркер всё равно не стартует и пишет причину в лог.
PIPELINE_ENABLED=false
METRICS_AUTO_REFRESH=false
BOT_ENABLED=false

# LM Studio (OpenAI-совместимый эндпоинт) — доверенный фиксированный адрес.
# Имя модели должно ТОЧНО совпадать с тем, что показывает --check.
# Контекст модели в LM Studio — 8192, не больше: 16K на 8B не помещается
# в 8 ГБ вместе с весами, модель уезжает в RAM и таймаутит.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen/qwen3-8b
LMSTUDIO_TIMEOUT_MS=120000

# Версия промпта — участвует в ключе идемпотентности extractions.
# (SCHEMA_VERSION больше не читается: версия схемы задана в src/llm/schema.ts.)
PROMPT_VERSION=p1

# Пайплайн
# 1 на 8 ГБ VRAM: параллельные запросы держат по своему кэшу контекста.
EXTRACT_CONCURRENCY=1
EXTRACT_BATCH_SIZE=8
# Размер чанка в символах и их максимальное число. Меньший чанк — меньше
# таймаутов на длинных статьях. 3500/6 проверено на Qwen3 и 8 ГБ VRAM.
# Текст длиннее покрытия чанков не разбирается частично, а помечается failed.
EXTRACT_CHUNK_SIZE=3500
EXTRACT_MAX_CHUNKS=6

# Ингест
TG_FETCH_DELAY_MS=4000
INGEST_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0 Safari/537.36

# Telegram-бот для приёма форвардов (BotFather). Заполняется вручную.
# Работает только при BOT_ENABLED=true и подтверждённом допуске источника manual:bot.
TG_BOT_TOKEN=
TG_BOT_ALLOWED_USER_IDS=
