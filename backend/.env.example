# Копировать в backend/.env и заполнить вручную. Файл .env в git не попадает.

DATABASE_URL=postgresql://user:password@localhost:5432/tg_info
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_PATH=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# API слушает только loopback: 127.0.0.1, ::1 или localhost. Иное — ошибка запуска.
HOST=127.0.0.1
PORT=4100
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Вход по токену снят на время разработки: OPERATOR_TOKEN, SESSION_IDLE_MINUTES
# и SESSION_MAX_HOURS больше не читаются. Защита — только loopback, Host и Origin.

# Фоновые задания. Только true/false/1/0. Поток «сбор → разбор → публикация»
# по умолчанию включён: портал работает сам. Каждая строка — рубильник.
# Сбор идёт ТОЛЬКО по источникам с подтверждённым допуском: включённый флаг
# сам по себе никуда не ходит.
INGEST_ENABLED=true
# Разбор моделью новым конвейером (этап 03B): запуски и наборы кандидатов.
PIPELINE_ENABLED=true
# Публиковать готовые наборы автоматически. Неполный и упавший запуск не
# публикуются ни при каком значении; устаревший разбор остаётся кандидатом.
# false — наборы ждут npm run pipeline:once -- --preview/--publish.
REPROCESS_AUTO_PUBLISH=true
# Слияние компаний и объектов с предпросмотром, журналом и отменой (этап 04).
# false — предпросмотр и история доступны, применить и отменить нельзя.
# Слияние необратимо, поэтому остаётся выключенным.
MERGE_APPLY_ENABLED=false
METRICS_AUTO_REFRESH=true
# Бот без токена бессмыслен — включается вместе с TG_BOT_TOKEN.
BOT_ENABLED=false
# Запись публикаций и неизменяемых редакций (миграция 011). false — откат к
# прежнему поведению: правки постов снова теряются, чтение не страдает.
REVISION_WRITE_ENABLED=true

# LM Studio (OpenAI-совместимый эндпоинт) — доверенный фиксированный адрес.
# Имя модели должно ТОЧНО совпадать с тем, что показывает --check.
# Контекст модели в LM Studio — 8192, не больше: 16K на 8B не помещается
# в 8 ГБ вместе с весами, модель уезжает в RAM и таймаутит.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen/qwen3-8b
LMSTUDIO_TIMEOUT_MS=120000

# Версия промпта — участвует в ключе идемпотентности extractions.
# (SCHEMA_VERSION больше не читается: версия схемы задана в src/llm/schema.ts.)
PROMPT_VERSION=p1
# Схема ответа модели для новых запусков конвейера (этап 06): extract@3 — типизированные связи
# и события; extract@2 — откат к прежней схеме (прежние запуски и наборы не меняются).
EXTRACT_SCHEMA_VERSION=extract@3
# Схема связей, снимки и выгрузки досье (этап 08B); false — отключить маршруты, прежние снимки сохраняются.
GRAPH_EXPORT_ENABLED=true
# Запись канона из реестра (этап 20B): объект, юрлицо застройщика с реквизитом, роль застройщика,
# связь с группой компаний. Модель не участвует. false — реестр собирается снимками,
# но карточки из него не строятся; уже собранное остаётся в базе.
REGISTRY_PUBLISH_ENABLED=true

# Пайплайн
# 1 на 8 ГБ VRAM: параллельные запросы держат по своему кэшу контекста.
EXTRACT_CONCURRENCY=1
EXTRACT_BATCH_SIZE=8
# Размер чанка в символах и их максимальное число. Меньший чанк — меньше
# таймаутов на длинных статьях. 3500/6 проверено на Qwen3 и 8 ГБ VRAM.
# Текст длиннее покрытия чанков не разбирается частично, а помечается failed.
EXTRACT_CHUNK_SIZE=3500
EXTRACT_MAX_CHUNKS=6

# Тема публикации локальной моделью (headline@1): одна строка о чём текст.
# Нужна там, где у публикации нет заголовка (telegram-посты). Тема — машинная
# подпись, не заголовок источника и не доказательство; в цитаты не идёт.
# false — тем не будет, уже сохранённые остаются. Идёт тем же заданием, что и
# разбор (PIPELINE_ENABLED): два параллельных запроса делят VRAM.
HEADLINE_ENABLED=true
HEADLINE_BATCH_SIZE=10
# Сколько символов начала текста видит модель: тема — про начало, не пересказ.
HEADLINE_INPUT_CHARS=1200

# Ингест
TG_FETCH_DELAY_MS=4000
INGEST_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0 Safari/537.36

# Telegram-бот для приёма форвардов (BotFather). Заполняется вручную.
# Работает только при BOT_ENABLED=true и подтверждённом допуске источника manual:bot.
TG_BOT_TOKEN=
TG_BOT_ALLOWED_USER_IDS=
