# Копировать в backend/.env и заполнить вручную. Файл .env в git не попадает.

DATABASE_URL=postgresql://user:password@localhost:5432/tg_info
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# LM Studio (OpenAI-совместимый эндпоинт)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen3-8b
LMSTUDIO_TIMEOUT_MS=120000

# Версии промпта/схемы — участвуют в ключе идемпотентности extractions
PROMPT_VERSION=p1
SCHEMA_VERSION=extract@1

# Пайплайн
EXTRACT_CONCURRENCY=2
EXTRACT_BATCH_SIZE=8
# Размер чанка в символах и их максимальное число. Меньший чанк — меньше
# таймаутов на длинных статьях. 3500/6 проверено на Qwen3 и 8 ГБ VRAM.
EXTRACT_CHUNK_SIZE=3500
EXTRACT_MAX_CHUNKS=6

# Ингест
TG_FETCH_DELAY_MS=4000
INGEST_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0 Safari/537.36

# Telegram-бот для приёма форвардов (BotFather). Заполняется вручную.
TG_BOT_TOKEN=
TG_BOT_ALLOWED_USER_IDS=

PORT=4100
CORS_ORIGINS=http://localhost:5173
