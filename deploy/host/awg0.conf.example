# /etc/amnezia/amneziawg/awg0.conf на quantor — сплит-туннель до nl3 только для Telegram.
#
# С Selectel t.me и api.telegram.org не открываются (замер 29.09.2026: таймаут по IPv4,
# маршрута IPv6 нет). Через туннель идут только сети Telegram; всё остальное — Quantor,
# сайты, реестр, обновления — напрямую с адреса сервера.
#
# Откуда значения: владелец создаёт клиента в приложении Amnezia на сервере nl3 (протокол
# AmneziaWG) и экспортирует конфигурацию. Из неё берутся ключи, адрес и параметры обфускации
# без изменений. Три правки против экспорта:
#   1. строки DNS = … нет — DNS сервера не меняется;
#   2. AllowedIPs — только сети Telegram (ниже), а не 0.0.0.0/0;
#   3. Table остаётся auto — маршруты ставятся только на AllowedIPs, default route не трогается.
# Файл — chmod 600, в git не попадает (ключи).

[Interface]
PrivateKey = <из экспорта Amnezia>
Address = <адрес клиента в туннеле из экспорта>/32
# Параметры обфускации — строки Jc, Jmin, Jmax, S1…S4, H1…H4, I1…I5 из экспорта как есть.

[Peer]
PublicKey = <из экспорта>
PresharedKey = <из экспорта>
Endpoint = <адрес nl3>:<порт AmneziaWG из экспорта>
# Сети Telegram, IPv4: https://core.telegram.org/resources/cidr.txt (сверить при настройке).
# IPv6 не нужен: у сервера нет маршрута IPv6, и клиент сразу переходит на IPv4.
AllowedIPs = 91.105.192.0/23, 91.108.4.0/22, 91.108.8.0/22, 91.108.12.0/22, 91.108.16.0/22, 91.108.20.0/22, 91.108.56.0/22, 95.161.64.0/20, 149.154.160.0/20, 185.76.151.0/24
PersistentKeepalive = 25
