# /etc/amnezia/amneziawg/awg0.conf на quantor — сплит-туннель до nl3 только для Telegram.
#
# С Selectel t.me и api.telegram.org не открываются (замер 29.09.2026: таймаут по IPv4,
# маршрута IPv6 нет), OpenRouter отвечает 403 на любой запрос (30.09.2026). Через туннель идут
# только сети Telegram и адреса openrouter.ai; всё остальное — Quantor, сайты, реестр,
# обновления — напрямую с адреса сервера.
#
# Откуда значения: владелец создаёт клиента в приложении Amnezia на сервере nl3 (контейнер
# amnezia-awg2, AmneziaWG 3.1) и экспортирует конфигурацию. Экспорт vpn://… — это base64url от
# qCompress(JSON); текст конфига лежит в containers[0].awg.last_config → config. Из него берутся
# ключи, адрес и параметры обфускации без изменений. Три правки против экспорта:
#   1. строки DNS = … нет — DNS сервера не меняется;
#   2. AllowedIPs — только сети Telegram (ниже), а не 0.0.0.0/0;
#   3. Table остаётся auto — маршруты ставятся только на AllowedIPs, default route не трогается.
# Файл — chmod 600, в git не попадает (ключи).

[Interface]
PrivateKey = <из экспорта Amnezia>
Address = <адрес клиента в туннеле из экспорта>/32
# Параметры обфускации и AWG 3.x — строки Jc, Jmin, Jmax, S1…S4, H1…H4, HeaderProtectionKey,
# ContentPaddingAddition, Rekey*/Reject*/Keepalive*, MaxHandshakeAttempts, RandomTrailers,
# DisableCookies из экспорта как есть. Нужны amneziawg-tools и модуль ядра 3.1+ (PPA amnezia).

[Peer]
PublicKey = <из экспорта>
PresharedKey = <из экспорта>
Endpoint = <адрес nl3>:<порт AmneziaWG из экспорта>
# Сети Telegram, IPv4: https://core.telegram.org/resources/cidr.txt (сверено 30.09.2026).
# IPv6 не нужен: у сервера нет маршрута IPv6, и клиент сразу переходит на IPv4.
# Хвост — адреса openrouter.ai (/32, 30.09.2026): два, которые отдаёт DNS сервера, и два, которые отдают
# другие резолверы. Снова 403 от OpenRouter — `getent ahostsv4 openrouter.ai` и дописать (deploy/README.md).
AllowedIPs = 91.105.192.0/23, 91.108.4.0/22, 91.108.8.0/22, 91.108.12.0/22, 91.108.16.0/22, 91.108.20.0/22, 91.108.56.0/22, 149.154.160.0/20, 185.76.151.0/24, 8.47.69.0/32, 8.6.112.0/32, 104.18.2.115/32, 104.18.3.115/32
PersistentKeepalive = <из экспорта, например 25-35>
