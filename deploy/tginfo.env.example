# /opt/portals/tg-info/.env — заполняет владелец на сервере, chmod 600. В git и переписку не попадает.
# Режим входа, адрес API, доверие прокси и строка подключения к базе зашиты в docker-compose.yml.

# База: openssl rand -hex 24 (только hex — пароль входит в строку подключения без экранирования).
POSTGRES_PASSWORD=

# Вход — по логину и паролю (ADR-014): пользователи живут в базе, первый администратор создаётся
# командой ./compose.sh exec api node dist/auth/cli.js --create-admin <логин>. Токена больше нет.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
# Адрес портала: https и то же имя, что в nginx/tginfo.conf.
PUBLIC_ORIGIN=https://pulse.meridianai.ru

# Модель на домашнем ПК — через обратный SSH-туннель на шлюз внутренней сети.
LMSTUDIO_BASE_URL=http://172.30.0.1:1234/v1
LMSTUDIO_TIMEOUT_MS=120000
# Конфигурация разбора — ровно как у рабочей базы (раздел config в before-manifest.json).
# Модель и версии входят в идентичность запуска (execution-identity@1): другое значение —
# и поставленные запуски считаются чужой конфигурацией, а сверка переноса — CONFIG_MISMATCH.
LMSTUDIO_MODEL=qwen/qwen3-8b
# Модель в OpenRouter вместо домашнего ПК — только решением владельца (тексты уходят внешнему сервису),
# подробности — backend/.env.example. Тогда LMSTUDIO_BASE_URL=https://openrouter.ai/api/v1, туннель не нужен.
#LLM_PROVIDER=openrouter
# Ключ задаётся в админке → «Модель»; LLM_API_KEY — запасной, если в админке ключа нет.
#LLM_API_KEY=
#OPENROUTER_PROVIDERS=
PROMPT_VERSION=p3
EXTRACT_SCHEMA_VERSION=extract@3
EXTRACT_CHUNK_SIZE=3500
EXTRACT_MAX_CHUNKS=6
EXTRACT_CONCURRENCY=1

# Форвард-бот. Пустой список пользователей — не принимать никого.
TG_BOT_TOKEN=
TG_BOT_ALLOWED_USER_IDS=

# Фоновые задания. Первый запуск — всё выключено; включать по одному (deploy/README.md, шаг 7).
INGEST_ENABLED=false
# Браузерный сбор ДОМ.РФ — у API не включать (в образе Alpine нет Chromium): карточки снимает отдельный
# контейнер tginfo-domrf (этап 20D), там флаг включён в docker-compose.yml.
DOMRF_BROWSER_ENABLED=false
PIPELINE_ENABLED=false
HEADLINE_ENABLED=false
# Подсказки модели к найденному в реестре ДОМ.РФ: идут с разбором (PIPELINE_ENABLED) и только после
# «Разрешить подсказки» на странице наш.дом.рф в админке.
DOMRF_HINT_ENABLED=true
# Разбор разногласий моделью: пары «возможный дубль» и совпадения с ДОМ.РФ. ENABLED — только вердикт и причина
# рядом с парой; APPLY — применять (слияние — ещё и при MERGE_APPLY_ENABLED). Разные ИНН/ОГРН модель не сливает.
MODEL_REVIEW_ENABLED=false
MODEL_REVIEW_APPLY=false
METRICS_AUTO_REFRESH=false
# Контур.Фокус (ADR-015): ключ — в админке → «Источники» → Контур.Фокус; FOCUS_API_KEY — запасной.
# Без ключа запросов нет. Лимит — запросов за сутки (компания — два).
FOCUS_ENABLED=true
FOCUS_DAILY_LIMIT=100
FOCUS_REFRESH_DAYS=14
#FOCUS_API_KEY=
# parser-api.com (этап 24A): ГИР БО, «Прозрачный бизнес», арбитражные дела, ФССП, Федресурс по ИНН.
# Ключ — в админке → «Источники» → parser-api.com; PARSER_API_KEY — запасной. Расписание — только компании
# «на контроле»; включать после пробы. Лимиты портала: сутки и календарный месяц (бесплатный тариф — 200/мес).
PARSER_API_ENABLED=false
PARSER_API_DAILY_LIMIT=20
PARSER_API_MONTHLY_LIMIT=200
PARSER_API_KAD_MAX_PAGES=3
#PARSER_API_KEY=
BOT_ENABLED=false
REPROCESS_AUTO_PUBLISH=true
MERGE_APPLY_ENABLED=false
